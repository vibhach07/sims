# ── SIMS Raipur Backend — Environment Variables Example ─────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Django Core
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-50-chars-minimum
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (leave unset for local SQLite dev)
# DATABASE_URL=postgresql://user:password@localhost:5432/sims_raipur

# Razorpay (use test keys for staging)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@simsraipuredu.in
EMAIL_HOST_PASSWORD=app-specific-password-here
DEFAULT_FROM_EMAIL=SIMS Raipur <noreply@simsraipuredu.in>

# Frontend URL (used in email templates)
FRONTEND_URL=https://yourdomain.com
